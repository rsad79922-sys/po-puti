# Add to the existing protected server env; never overwrite the working env.
# No paid fallback or API auto-activation. Obtain exact free quota/TTL from the account.
YANDEX_RASP_API_KEY=
RASP_LICENSE_CONFIRMED=false
RASP_DAILY_LIMIT=0
RASP_CACHE_SECONDS=0
# TTL applies to both temporary search and station lookup data; no permanent Yandex archive.
ADS_ENABLED=false
ADS_TERMS_CONFIRMED=false
ADS_TEST_MODE=true
ADS_WEB_SEARCH_ID=
ADS_WEB_RESULTS_ID=
ADS_ANDROID_SEARCH_ID=
ADS_ANDROID_RESULTS_ID=
# Exact HTTPS origins authorized by the current web-ad integration, comma-separated.
ADS_WEB_CSP_ORIGINS=
# Complete and approve the actual policy before enabling ads or store release.
PRIVACY_OPERATOR=
PRIVACY_CONTACT=
# v6 self-service erasure uses password confirmation; this flag gates store readiness only.
PRIVACY_POLICY_APPROVED=false
# Separate written confirmation for the actual use of Yandex Geocoder coordinates
# with BRouter/storage, if that provider is retained. A free API key is insufficient.
GEOCODING_LICENSE_CONFIRMED=false
GEOCODING_LICENSE_REFERENCE=
# Server adapter only. Native SDK/device integration is a separate release prerequisite.
RUSTORE_PUSH_PROJECT_ID=
RUSTORE_PUSH_SERVICE_TOKEN=
# Public metadata of the previous store release, never a keystore/password.
ANDROID_PREVIOUS_VERSION_CODE=
ANDROID_PREVIOUS_CERT_SHA256=
# Generate once directly into protected server settings: openssl rand -base64 32
# Keep a separate encrypted backup: changing this key makes existing MFA secrets unreadable.
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_MFA_REQUIRED=false
