[Unit]
Description=Po Puti Android/PWA backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=poputi
Group=poputi
WorkingDirectory=/opt/po-puti
Environment=NODE_ENV=production
EnvironmentFile=/etc/po-puti/po-puti.env
ExecStart=/usr/bin/node /opt/po-puti/server/server.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
StateDirectory=po-puti
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/po-puti
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
