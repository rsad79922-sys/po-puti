# Copy to /etc/po-puti/po-puti.env, edit on the server; NEVER commit actual secrets.
PUBLIC_ORIGIN=https://vputipoputka.ru
HOST=127.0.0.1
PORT=8080
DATA_DIR=/var/lib/po-puti
APP_ORIGINS=https://vputipoputka.ru,https://localhost
# First admin: scripts/admin-user.mjs --user-id EXISTING_ID --reason 'Verified owner'
# Optional push settings: use a private /etc/po-puti/push.env EnvironmentFile.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.invalid
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON=/etc/po-puti/fcm-service-account.json
# Routing v4: use private /etc/po-puti/routing.env EnvironmentFile.
# ROUTING_PROVIDER=osrm
# ROUTING_URL=https://YOUR_OWN_ROUTER
# ROUTING_API_KEY=
# ROUTING_FALLBACK_PROVIDER=valhalla
# ROUTING_FALLBACK_URL=https://YOUR_OWN_VALHALLA
# ROUTING_FALLBACK_API_KEY=
# GEOCODING_URL=https://YOUR_OWN_GEOCODER/search
# Yandex Routing: ROUTING_PROVIDER=yandex, ROUTING_URL=https://api.routing.yandex.net
# GEOCODING_PROVIDER=yandex
# GEOCODING_API_KEY=
