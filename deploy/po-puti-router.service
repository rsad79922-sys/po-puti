[Unit]
Description=Po Puti free BRouter car routing on OpenStreetMap
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=poputi-router
Group=poputi-router
WorkingDirectory=/opt/po-puti-brouter/current
ExecStart=/usr/bin/java -Xms64m -Xmx1280m -DmaxRunningTime=28 -cp /opt/po-puti-brouter/current/brouter-1.7.10-all.jar btools.server.RouteServer /var/lib/po-puti-brouter/current /opt/po-puti-brouter/current/profiles2 /opt/po-puti-brouter/custom-profiles 17777 1 127.0.0.1
Restart=on-failure
RestartSec=5
MemoryHigh=1536M
MemoryMax=2048M
CPUQuota=100%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
# BRouter stdout includes exact route queries; avoid retaining those in the journal.
StandardOutput=null
StandardError=journal
SyslogIdentifier=po-puti-router

[Install]
WantedBy=multi-user.target
